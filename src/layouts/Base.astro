---
import { getCollection } from 'astro:content';

interface Props {
  titre: string;
  description?: string;
}

const { titre, description } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const lien = (id: string) => (id === 'accueil' ? `${base}/` : `${base}/${id}/`);

const menu = (await getCollection('pages'))
  .filter((page) => page.data.ordre !== undefined)
  .sort((a, b) => a.data.ordre! - b.data.ordre!);

const actuelle = Astro.url.pathname.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <header>
      <div class="conteneur">
        <a class="logo" href={`${base}/`}>Prospective</a>
        <nav aria-label="Menu principal">
          <ul>
            {
              menu.map((page) => (
                <li>
                  <a
                    href={lien(page.id)}
                    aria-current={lien(page.id) === actuelle ? 'page' : undefined}
                  >
                    {page.data.titre}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main class="conteneur">
      <slot />
    </main>

    <footer>
      <div class="conteneur">© {new Date().getFullYear()} Prospective</div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --texte: #1f2328;
    --fond: #ffffff;
    --accent: #0b5cad;
    --discret: #f3f4f6;
    --largeur: 70rem;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
    line-height: 1.6;
    color: var(--texte);
    background: var(--fond);
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  a {
    color: var(--accent);
  }

  h1 {
    font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.5rem);
    line-height: 1.2;
  }

  /* Largeur limitée et marges latérales sur tous les écrans */
  .conteneur {
    width: 100%;
    max-width: var(--largeur);
    margin: 0 auto;
    padding: 0 1rem;
  }

  header {
    border-bottom: 1px solid var(--discret);
  }

  header .conteneur {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1rem;
  }

  .logo {
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--texte);
    text-decoration: none;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    text-decoration: none;
    padding: 0.25rem 0;
  }

  nav a[aria-current='page'] {
    font-weight: 600;
    border-bottom: 2px solid var(--accent);
  }

  main {
    flex: 1;
    padding-block: 2rem;
  }

  footer {
    background: var(--discret);
    padding-block: 1.5rem;
    font-size: 0.9rem;
  }

  /* Tablette et ordinateur : plus d'espace */
  @media (min-width: 48rem) {
    .conteneur {
      padding: 0 2rem;
    }

    main {
      padding-block: 3rem;
    }
  }
</style>
